# H5 通过 CloudBase Web SDK 调用云函数。这里只允许放可公开的客户端配置。
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_PUBLISHABLE_KEY=
VITE_AI_FUNCTION_NAME=generateShoeImage
VITE_AI_SOURCE_INVOLUTION_URL=
VITE_AI_SOURCE_SHOWOFF_URL=
VITE_AI_SOURCE_SLACKER_URL=
VITE_AI_SOURCE_LOVE_FEET_URL=

# 以下为 CloudBase 云函数 generateShoeImage 的服务端变量名，只作说明，不要在本文件填写值：
# LUCEN_API_KEY（兼容旧变量名 OPENAI_API_KEY）
# AI_API_BASE_URL=https://lucen.plus/v1
# AI_MAIN_MODEL=gpt-5.5
# AI_IMAGE_MODEL=gpt-image-2.5-sunburst
# AI_GENERATION_ENABLED=false（首次能力测试前保持 false）
